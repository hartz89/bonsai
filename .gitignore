# bonsai local state — see reference/git-strategy.md
# Observations contain verbatim excerpts of your conversations. Machine-local by design.
.claude/bonsai/observations.jsonl
.claude/bonsai/proposals/
.claude/bonsai/archive/
.claude/bonsai/.state/

# Personal instructions
CLAUDE.local.md
.claude/settings.local.json

# Local scratch space — drafts, notes, marketing copy, anything not part of the project
.local/

# Feedback from repos running bonsai in production. Quotes real sessions in other people's
# projects, so it stays machine-local like observations do — findings graduate to docs/backlog.md.
DOGFOOD-FEEDBACK.md

# Worktrees bonsai creates for isolated harness commits
.bonsai-worktrees/

# OS / editor
.DS_Store
*.swp
